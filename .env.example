# MareaEnlace — variables de entorno requeridas
# Copia este archivo a .env.local y completa los valores reales.
# Nunca subas .env.local a Git.

# URL pública del proyecto Supabase (se usa en cliente y servidor)
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=tu-clave-publica-publishable

# Conexión de la aplicación (solo se lee en el servidor; pooler de Supabase).
# La app fuerza TLS aunque la URL no incluya sslmode. Con pg 8, "sslmode=require"
# se interpreta como "verify-full"; si necesitas controlarlo, usa
# "uselibpqcompat=true&sslmode=require".
DATABASE_URL=postgresql://usuario:contrasena@host.ejemplo:6543/base-de-datos

# Conexión exclusiva para las herramientas de migración (drizzle-kit)
DATABASE_MIGRATION_URL=postgresql://usuario:contrasena@host.ejemplo:5432/base-de-datos